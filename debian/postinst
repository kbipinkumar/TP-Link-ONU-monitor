#!/bin/bash
set -e

# Create dedicated user for the service
if ! id "onu-monitor" &>/dev/null; then
    useradd -r -s /usr/sbin/nologin -c "TP-Link ONU Monitor Service User" onu-monitor
fi

# Set up sudoers rule so the web GUI can restart the monitor timer
echo "onu-monitor ALL=(ALL) NOPASSWD: /bin/systemctl restart onu_monitor.timer" > /etc/sudoers.d/onu-monitor
chmod 0440 /etc/sudoers.d/onu-monitor

systemctl daemon-reload || true
systemctl enable onu_monitor.timer || true
systemctl start onu_monitor.timer || true
systemctl enable onu_monitor_web.service || true
systemctl start onu_monitor_web.service || true

# Initialize config file if it doesn't exist
if [ ! -f /opt/onu_monitor/onu_config.ini ]; then
    cp /opt/onu_monitor/onu_config.example.ini /opt/onu_monitor/onu_config.ini
fi
chown onu-monitor:onu-monitor /opt/onu_monitor/onu_config.ini || true
chmod 640 /opt/onu_monitor/onu_config.ini || true

echo "================================================================"
echo " TP-Link GPON ONU Monitor installed successfully!               "
echo " Please configure your credentials and MQTT/InfluxDB settings   "
echo " by accessing the Web GUI at:                                   "
echo "                                                                "
echo "          http://<your-device-ip>:8991                          "
echo "                                                                "
echo "================================================================"

exit 0
